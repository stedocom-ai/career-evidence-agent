# Configuration reference only. The CLI does not automatically load this file.
# Set environment variables in your shell. Never commit a real API key.
AGENT_API_KEY=replace-with-your-provider-key
AGENT_BASE_URL=https://api.provider.example/v1
AGENT_MODEL=replace-with-a-model-that-supports-tool-calling
# Optional provider-specific JSON. For the DeepSeek starter setup:
# AGENT_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Optional future Gmail SMTP sending only. Preview does not need credentials.
# Use a Google app password from an eligible account, never the normal password.
# Set locally in the shell when you decide to send; do not commit a real value.
GMAIL_APP_PASSWORD=

# Optional Graph OAuth setup only. Desktop Outlook does not need these variables.
# Use your own registered application client ID.
# This is an application identifier, not a password or client secret.
OUTLOOK_CLIENT_ID=replace-with-your-own-application-client-id
OUTLOOK_TENANT=consumers
